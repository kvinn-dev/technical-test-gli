# Docker Environment Configuration Example
# Copy this file to .env.docker or .env before running:
# docker compose --env-file .env.docker up --build

# Database Configuration
POSTGRES_DB=task_tracker
POSTGRES_USER=task_user
POSTGRES_PASSWORD=task_password
POSTGRES_PORT=5433

# Backend FastAPI Configuration
APP_NAME=Task Tracker API
DEBUG=True
# DATABASE_URL points to the internal Docker service name "db"
DATABASE_URL=postgresql+psycopg://task_user:task_password@db:5432/task_tracker
BACKEND_PORT=8000

# Frontend Configuration
# VITE_API_BASE_URL is accessed from the user's browser (outside Docker)
VITE_API_BASE_URL=http://localhost:8000
FRONTEND_PORT=8080
